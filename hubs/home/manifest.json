{
  "schema": 1,
  "id": "forjahq-home",
  "name": "ForjaHQ Home",
  "description": "TMDB movie and TV catalog for the Home tab.",
  "author": "ForjaHQ",
  "version": "1.0.69",
  "tags": [
    "home",
    "movies",
    "tv"
  ],
  "plugins": [
    {
      "id": "tmdb",
      "name": "Home",
      "description": "TMDB movie / TV hub",
      "entry": "tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "movie",
        "tv"
      ],
      "capabilities": [
        "nav",
        "layout",
        "feed",
        "rail",
        "search",
        "search_helpers",
        "structured_search",
        "filters",
        "details",
        "settings"
      ],
      "nav": {
        "label": "Home",
        "icon": "icons/nav.png",
        "accent": "#1CE783",
        "page": {
          "action": "layout"
        }
      },
      "settings": {
        "group": "Details",
        "order": 20,
        "fields": [
          {
            "id": "episodeView",
            "type": "select",
            "label": "Episode list",
            "subtitle": "Cards with stills, or numbered chips in a grid",
            "default": "cards",
            "options": [
              {
                "id": "cards",
                "label": "Cards"
              },
              {
                "id": "chips",
                "label": "Number chips"
              }
            ]
          }
        ],
        "greenPlay": {
          "technologies": {
            "allowlist": ["engine", "stremio", "nuvio", "torrent"],
            "preferred": ["engine"],
            "order": ["engine", "stremio", "nuvio", "torrent"]
          },
          "providers": {
            "engine": { "allowlist": [], "preferred": [], "order": [] },
            "stremio": { "allowlist": [], "preferred": [], "order": [] },
            "nuvio": { "allowlist": [], "preferred": [], "order": [] },
            "torrent": { "allowlist": [], "preferred": [], "order": [] }
          }
        }
      },
      "config": {
        "base": "https://tmdb.forjahq.xyz/3",
        "imageBase": "https://tmdb.forjahq.xyz/t/p",
        "apiKey": "",
        "pageSize": 20
      },
      "prelude": "_kit.js,_search.js,_layout.js"
    }
  ],
  "bundle": [
    "tmdb.js",
    "_kit.js",
    "_search.js",
    "_layout.js",
    "icons/nav.png",
    "logos/appletv.svg",
    "logos/crunchyroll.svg",
    "logos/disneyplus.svg",
    "logos/hulu.svg",
    "logos/max.svg",
    "logos/netflix.svg",
    "logos/paramountplus.svg",
    "logos/peacock.svg",
    "logos/primevideo.svg",
    "logos/tubi.svg"
  ]
}
