{
  "schema": 1,
  "id": "forjahq-my-list",
  "name": "ForjaHQ My List",
  "description": "Personal watchlists: local bookmarks and Simkl sync.",
  "author": "ForjaHQ",
  "version": "1.2.15",
  "tags": [
    "lists"
  ],
  "plugins": [
    {
      "id": "my-list-hub",
      "name": "My List",
      "description": "Personal watchlists — local bookmarks and Simkl sync",
      "entry": "my_list.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "list"
      ],
      "capabilities": [
        "nav",
        "layout",
        "feed",
        "settings"
      ],
      "enrich": "my-list-enrich-tmdb",
      "nav": {
        "label": "My List",
        "icon": "icons/nav.png",
        "accent": "#FBBF24",
        "page": {
          "action": "layout"
        }
      },
      "settings": {
        "addon": "my_list",
        "group": "Open hubs",
        "order": 10,
        "fields": [
          {
            "id": "openDefault.movie",
            "type": "hub_select",
            "hubTypes": [
              "movie"
            ],
            "listOpenDefault": true,
            "label": "Films",
            "subtitle": "Default hub for film rows when nothing is saved on the bookmark",
            "default": ""
          },
          {
            "id": "openDefault.tv",
            "type": "hub_select",
            "hubTypes": [
              "tv"
            ],
            "listOpenDefault": true,
            "label": "Series",
            "subtitle": "Default hub for series rows when nothing is saved on the bookmark",
            "default": ""
          },
          {
            "id": "openDefault.anime",
            "type": "hub_select",
            "hubTypes": [
              "anime"
            ],
            "listOpenDefault": true,
            "label": "Anime",
            "subtitle": "Default hub for anime rows when nothing is saved on the bookmark",
            "default": ""
          },
          {
            "id": "openDefault.drama",
            "type": "hub_select",
            "hubTypes": [
              "drama"
            ],
            "listOpenDefault": true,
            "label": "Asian Drama",
            "subtitle": "Default hub for Asian Drama rows when nothing is saved on the bookmark",
            "default": ""
          }
        ]
      },
      "prelude": "_kit.js,_layout.js"
    },
    {
      "id": "my-list-enrich-tmdb",
      "name": "My List TMDB enrich",
      "description": "TMDB hydrate for My List legacy rows (companion to my-list-hub)",
      "entry": "enrich_tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "capabilities": [
        "enrich"
      ],
      "config": {
        "base": "https://tmdb.forjahq.xyz/3",
        "imageBase": "https://tmdb.forjahq.xyz/t/p",
        "apiKey": ""
      },
      "prelude": "_kit.js"
    }
  ],
  "bundle": [
    "my_list.js",
    "_kit.js",
    "_layout.js",
    "enrich_tmdb.js",
    "icons/nav.png"
  ]
}
