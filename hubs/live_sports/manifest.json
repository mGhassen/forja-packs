{
  "schema": 1,
  "id": "forjahq-live-sports",
  "name": "ForjaHQ Live Sports Hub",
  "description": "Live sports schedule and streams.",
  "author": "ForjaHQ",
  "version": "1.0.67",
  "i18n": {
    "fr": {
      "Combine the same game across catalogs into one card. Off keeps every catalog row separate.": "Regroupe le même match de plusieurs catalogues en une seule carte. Désactivé, chaque ligne de catalogue reste séparée.",
      "Detail page": "Page de détails",
      "Enable Forja Live": "Activer Forja Live",
      "Enable Forja Sports": "Activer Forja Sports",
      "Live sports schedule and streams.": "Programme et flux du sport en direct.",
      "Match IPTV portal channels on Live TV": "Associer les chaînes des portails IPTV dans Live TV",
      "Merge matching events": "Fusionner les événements identiques",
      "Open matches in": "Ouvrir les matchs dans",
      "Setup": "Configuration",
      "Show the Forja Live server in Live Sports": "Afficher le serveur Forja Live dans Live Sports",
      "Side panel": "Panneau latéral",
      "Side panel beside the schedule, or a full detail page": "Panneau latéral à côté du programme, ou page de détails complète"
    }
  },
  "tags": [
    "sports",
    "live"
  ],
  "plugins": [
    {
      "id": "live-sports-hub",
      "name": "Live Sports",
      "description": "Live sports schedule and streams.",
      "entry": "live_sports.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "live_match"
      ],
      "capabilities": [
        "nav",
        "layout",
        "feed",
        "liveTv",
        "settings"
      ],
      "nav": {
        "tabId": "live_sports",
        "label": "Live Sports",
        "icon": "icons/nav.png",
        "accent": "#FB923C",
        "page": {
          "action": "layout"
        }
      },
      "settings": {
        "addon": "live_sports",
        "group": "Setup",
        "order": 10,
        "fields": [
          {
            "id": "forjaLiveEnabled",
            "type": "toggle",
            "label": "Enable Forja Live",
            "subtitle": "Show the Forja Live server in Live Sports",
            "default": true
          },
          {
            "id": "forjaSportsEnabled",
            "type": "toggle",
            "label": "Enable Forja Sports",
            "subtitle": "Match IPTV portal channels on Live TV",
            "default": true
          },
          {
            "id": "mergeMatchingEvents",
            "type": "toggle",
            "label": "Merge matching events",
            "subtitle": "Combine the same game across catalogs into one card. Off keeps every catalog row separate.",
            "default": true
          },
          {
            "id": "matchOpen",
            "type": "select",
            "label": "Open matches in",
            "subtitle": "Side panel beside the schedule, or a full detail page",
            "default": "panel",
            "reloadHub": false,
            "options": [
              {
                "id": "panel",
                "label": "Side panel"
              },
              {
                "id": "details",
                "label": "Detail page"
              }
            ]
          }
        ]
      },
      "prelude": "_prelude.js,_layout.js"
    }
  ],
  "bundle": [
    "live_sports.js",
    "_kit.js",
    "_feed.js",
    "_prelude.js",
    "_layout.js",
    "icons/nav.png"
  ]
}
