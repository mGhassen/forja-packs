{
  "schema": 1,
  "id": "forjahq-anime",
  "name": "ForjaHQ Anime",
  "description": "AniList-powered anime hub with search and details.",
  "author": "ForjaHQ",
  "version": "1.0.35",
  "tags": [
    "anime"
  ],
  "plugins": [
    {
      "id": "anilist",
      "name": "Anime",
      "description": "AniList anime hub",
      "entry": "anilist.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "anime"
      ],
      "capabilities": [
        "nav",
        "layout",
        "feed",
        "rail",
        "search",
        "search_helpers",
        "filters",
        "details"
      ],
      "nav": {
        "label": "Anime",
        "icon": "icons/nav.png",
        "accent": "#FB7185",
        "page": {
          "action": "layout"
        }
      },
      "enrich": "anime-enrich-tmdb",
      "config": {
        "graphql": "https://graphql.anilist.co",
        "perPage": 24
      },
      "prelude": "_kit.js,_search.js,_layout.js"
    },
    {
      "id": "anime-enrich-tmdb",
      "name": "TMDB Enrich",
      "description": "TMDB match enrich for Anime metas (companion to AniList)",
      "entry": "enrich_tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "anime"
      ],
      "capabilities": [
        "enrich"
      ],
      "config": {
        "rails": [
          "spotlight"
        ],
        "limit": 5
      },
      "prelude": "_kit.js,_search.js"
    }
  ],
  "bundle": [
    "anilist.js",
    "_kit.js",
    "_search.js",
    "_layout.js",
    "enrich_tmdb.js",
    "icons/nav.png"
  ]
}
