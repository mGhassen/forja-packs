{
  "schema": 1,
  "id": "forjahq-asian-drama",
  "name": "ForjaHQ Asian Drama",
  "description": "KissKH Asian drama catalog hub.",
  "author": "ForjaHQ",
  "version": "1.0.36",
  "tags": [
    "asian-drama",
    "drama"
  ],
  "plugins": [
    {
      "id": "kisskh-hub",
      "name": "Asian Drama",
      "description": "KissKH Asian drama hub",
      "entry": "kisskh.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "drama"
      ],
      "capabilities": [
        "nav",
        "layout",
        "rail",
        "search",
        "search_helpers",
        "details",
        "filters",
        "feed",
        "settings"
      ],
      "nav": {
        "label": "Asian Drama",
        "icon": "icons/nav.png",
        "accent": "#C4B5FD",
        "page": {
          "action": "layout"
        }
      },
      "settings": {
        "group": "Details",
        "order": 20,
        "fields": [
          {
            "id": "episodeView",
            "type": "select",
            "label": "Episode list",
            "subtitle": "Cards with stills, or numbered chips in a grid",
            "default": "cards",
            "options": [
              {
                "id": "cards",
                "label": "Cards"
              },
              {
                "id": "chips",
                "label": "Number chips"
              }
            ]
          }
        ]
      },
      "enrich": "enrich-tmdb",
      "config": {
        "base": "https://kisskh.co",
        "mirrors": [
          "https://kisskh.co",
          "https://kisskh.nl",
          "https://kisskh.ovh",
          "https://kisskh.la",
          "https://kisskh.do",
          "https://kisskh.is",
          "https://kisskh.id"
        ]
      },
      "prelude": "_kit.js,_search.js,_layout.js"
    },
    {
      "id": "enrich-tmdb",
      "name": "TMDB Enrich",
      "description": "TMDB match enrich for Asian Drama metas (companion to KissKH)",
      "entry": "enrich_tmdb.js",
      "kind": "catalog",
      "protocol": 1,
      "kit": 1,
      "types": [
        "drama"
      ],
      "capabilities": [
        "enrich"
      ],
      "config": {
        "base": "https://tmdb.forjahq.xyz/3",
        "imageBase": "https://tmdb.forjahq.xyz/t/p",
        "apiKey": "",
        "rails": [
          "spotlight"
        ],
        "limit": 5
      },
      "prelude": "_kit.js,_search.js"
    }
  ],
  "bundle": [
    "kisskh.js",
    "_kit.js",
    "_search.js",
    "_layout.js",
    "enrich_tmdb.js",
    "icons/nav.png"
  ]
}
